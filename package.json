{
  "name": "alien-studio",
  "version": "0.5.0",
  "description": "Estúdio de produção musical para Windows",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"vite build --config vite.host.config.ts --watch\" \"wait-on tcp:5173 file:dist-host/audio-host.cjs && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.host.json",
    "build": "npm run typecheck && vite build && npm run host",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win",
    "icon": "node scripts/make-icon.cjs",
    "drums": "node scripts/build-drums.cjs",
    "perc": "node scripts/build-perc.cjs",
    "instruments": "node scripts/build-instruments.cjs",
    "dist:mac": "npm run build && electron-builder --mac",
    "host": "vite build --config vite.host.config.ts"
  },
  "build": {
    "appId": "com.musicmaker.app",
    "productName": "Alien Studio",
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.ico",
      "dist-host/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Alien Studio",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "language": "1046",
      "installerLanguages": [
        "pt_BR"
      ],
      "artifactName": "AlienStudio-Setup-${version}.exe",
      "uninstallDisplayName": "Alien Studio"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.music",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "AlienStudio-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "O Alien Studio usa a entrada de áudio para gravar e monitorar guitarra, baixo, voz ou outro instrumento ligado à sua interface de áudio."
      }
    },
    "dmg": {
      "title": "Alien Studio ${version}"
    },
    "asarUnpack": [
      "node_modules/audify/**"
    ],
    "npmRebuild": false
  },
  "dependencies": {
    "audify": "^1.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "libflacjs": "^5.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1",
    "wasm-media-encoders": "^0.7.0"
  }
}
